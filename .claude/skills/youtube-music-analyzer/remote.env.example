# youtube-music-analyzer: GPU server cho scripts/remote.sh (tải + phân tích video tham khảo).
# Chép thành remote.env (cùng thư mục, không vào git) rồi điền. Không ghi chú cuối dòng: script Python đọc nguyên giá trị.
# user@host của GPU server (bắt buộc)
YTA_REMOTE=
# SSH key
YTA_KEY=$HOME/.ssh/id_rsa
# số job song song trên server (trống = mặc định của script)
YTA_JOBS=
