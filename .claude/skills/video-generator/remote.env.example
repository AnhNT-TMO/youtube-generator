# video-generator: GPU server cho video.py loop / batch / album và Google Drive (hoặc S3) cho video.py package.
# Chép thành remote.env (cùng thư mục, không vào git) rồi điền. Không ghi chú cuối dòng: script Python đọc nguyên giá trị.
# user@host của GPU server (bắt buộc)
VG_REMOTE=
# SSH key
VG_KEY=$HOME/.ssh/id_rsa
# số job render song song
VG_JOBS=16
# thư mục làm việc trên server (~/<VG_DIR>)
VG_DIR=video-generator

# video.py package: zip tạo trên server, server upload lên Google Drive bằng rclone.
# Remote rclone trên server (một lần: `rclone authorize drive` rồi `rclone config create <tên> drive token ...`).
# Đường dẫn: <remote>:<prefix><channel>/albums/<album>/<slug>-<time>.zip. Để trống VG_DRIVE_REMOTE thì dùng S3 bên dưới.
VG_DRIVE_REMOTE=
# vd. youtube-packages/ (có dấu / cuối)
VG_DRIVE_PREFIX=

# Dự phòng khi không có VG_DRIVE_REMOTE: zip upload lên S3 bằng presigned request ký trên Mac này
# (AWS credentials: default chain, hoặc profile bên dưới). Key: <prefix><channel>/albums/<album>/<slug>-<time>.zip
VG_S3_BUCKET=
VG_S3_REGION=ap-northeast-1
# vd. myname/ (có dấu / cuối)
VG_S3_PREFIX=
VG_AWS_PROFILE=
