# verification-audio: GPU server cho scripts/remote.sh (verify.py check; youtube-music-analyzer gọi push).
# Chép thành remote.env (cùng thư mục, không vào git) rồi điền. Không ghi chú cuối dòng: script Python đọc nguyên giá trị.
# user@host của GPU server (bắt buộc)
QC_REMOTE=
# SSH key
QC_KEY=$HOME/.ssh/id_rsa
# bản sao repo trên server (~/<QC_DIR>), dùng chung với album-assembly
QC_DIR=youtube-qc
