# audio-album-assembly: GPU server cho scripts/remote.sh (assemble.py render: ghép + đo loudness cả bài).
# Chép thành remote.env (cùng thư mục, không vào git) rồi điền. Không ghi chú cuối dòng: script đọc nguyên giá trị.
# user@host của GPU server (bắt buộc)
QC_REMOTE=
# SSH key
QC_KEY=$HOME/.ssh/id_rsa
# bản sao repo trên server (~/<QC_DIR>), dùng chung với audio-song-naming
QC_DIR=youtube-qc
