# audio-song-naming: GPU server cho scripts/remote.sh (songs.py words: Whisper timestamp từng chữ).
# Chép thành remote.env (cùng thư mục, không vào git) rồi điền. Không ghi chú cuối dòng: script đọc nguyên giá trị.
# user@host của GPU server (bắt buộc)
QC_REMOTE=
# SSH key
QC_KEY=$HOME/.ssh/id_rsa
# bản sao repo trên server (~/<QC_DIR>), dùng chung với audio-album-assembly
QC_DIR=youtube-qc
