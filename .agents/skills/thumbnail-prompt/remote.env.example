# thumbnail-prompt: GPU server cho thumb.py fit / upscale-setup (upscale SeedVR2 7B lên 4K).
# Chép thành remote.env (cùng thư mục, không vào git) rồi điền. Không ghi chú cuối dòng: script Python đọc nguyên giá trị.
# user@host của GPU server (bắt buộc)
TP_REMOTE=
# SSH key (bắt buộc)
TP_KEY=$HOME/.ssh/id_rsa
# thư mục SeedVR2 trên server (~/<TP_DIR>)
TP_DIR=thumbnail-prompt
